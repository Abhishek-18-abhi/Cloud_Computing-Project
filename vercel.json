{
  "version": 2,
  "buildCommand": "node build.js",
  "outputDirectory": "my-react-app/dist",
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://cloud-computing-mth1.vercel.app/api/health"
    },
    {
      "source": "/api/:match*",
      "destination": "https://cloud-computing-mth1.vercel.app/api/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}